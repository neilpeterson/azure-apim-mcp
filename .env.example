# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit it. Loaded automatically by `make run`
# (src/apim_mcp/server.py:main); NOT read by the test suite, which is fully
# offline against tests/fixtures/. See docs/LOCAL_TESTING.md.

AZURE_TENANT_ID=
# Only read for ManagedIdentityCredential (src/apim_mcp/auth/credentials.py) —
# inert when APIM_MCP_LOCAL_DEV_CREDENTIAL=1 below is set, which is the
# normal case for a laptop. Leave as a placeholder unless you unset that.
AZURE_CLIENT_ID=

# Must be a URL, matching the server app registration's Application ID URI
# character-for-character (docs/SPEC.md §4.3) — e.g. http://localhost:8000/mcp
# for local dev, or https://<container-app-host>/mcp once deployed. Not an
# `api://` string.
MCP_SERVER_AUDIENCE=
# The server app registration's Application (client) ID (a GUID). Entra v2
# tokens always set `aud` to this value, not the Application ID URI above.
MCP_SERVER_APP_ID=
# MCP_REQUIRED_ROLE=Apim.Read

APIM_SERVICES=[{"alias":"prod","resourceId":"/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ApiManagement/service/<name>"}]

APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000

# Uncomment to authenticate downstream ARM calls with your own `az login`
# session instead of ManagedIdentityCredential — required to run against a
# real APIM instance from a laptop. Never set this in Container Apps.
# APIM_MCP_LOCAL_DEV_CREDENTIAL=1

# INDEX_TTL_SECONDS=900
# INDEX_MAX_CONCURRENCY=8
# MAX_RESPONSE_BYTES=48000
